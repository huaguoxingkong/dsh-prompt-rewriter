    "twistCss": "'.dsh-pe_twist{display:block;width:20px;height:16px;overflow:visible;color:var(--dsw-alias-brand-primary-new-colorprimary-new-color,#4176e6)}',",
    "twistPathCss": "'.dsh-pe_twist path{fill:currentColor;fill-rule:evenodd}',",
    "whaleTailFn": "function WhaleTail() {\n\t\t\treturn h(\n\t\t\t\t'svg',\n\t\t\t\t{\n\t\t\t\t\tclassName: 'dsh-pe_twist',\n\t\t\t\t\tviewBox: TWIST_VIEWBOX,\n\t\t\t\t\t// The CSS box already carries the contour's 1.25 ratio, so meeting it\n\t\t\t\t\t// exactly fills the box instead of letterboxing the drawing.\n\t\t\t\t\tpreserveAspectRatio: 'xMidYMid meet',\n\t\t\t\t\t'aria-hidden': true,\n\t\t\t\t\tfocusable: 'false',\n\t\t\t\t},\n\t\t\t\th('path', { d: TWIST_FRAMES[0] }),\n\t\t\t);\n\t\t}",
    "keyframesFn": "function twistKeyframesRule() {\n\t\t\tconst divisor = TWIST_FRAMES.length;\n\t\t\tconst steps = TWIST_FRAMES.map(\n\t\t\t\t(pose, index) => `${((index * 100) / divisor).toFixed(4)}%{d:path('${pose}')}`,\n\t\t\t).join('');\n\t\t\treturn `@keyframes dsh-pe-twist{${steps}100%{d:path('${TWIST_FRAMES[0]}')}}`;\n\t\t}",
    "installStyles": "function installStyles() {\n\t\t\tconst tag = document.createElement('style');\n\t\t\ttag.dataset.promptEnhance = '1';\n\t\t\ttag.textContent = `${CSS}${twistKeyframesRule()}.dsh-pe_twist path{animation:dsh-pe-twist ${TWIST_DURATION_MS}ms steps(1,end) infinite}@media (prefers-reduced-motion:reduce){.dsh-pe_twist path{animation:none}}`;\n\t\t\tdocument.head.append(tag);\n\t\t\treturn () => tag.remove();\n\t\t}"
